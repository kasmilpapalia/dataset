import pandas as pd

# ==========================================
# 1. PERSIAPAN DATA
# ==========================================
file_path = '/content/dataset_font2.xlsx'
try:
    df = pd.read_excel(file_path)
    df = df.dropna(subset=['Char'])  # Hapus baris kosong
    kolom_fitur = [col for col in df.columns if col.startswith('X')]
except FileNotFoundError:
    print(f"Error: File '{file_path}' tidak ditemukan.")
    exit()

# ==========================================
# 2. FUNGSI PENCARIAN
# ==========================================
def huruf_ke_pola(huruf):
    hasil = df[df['Char'].str.upper() == huruf.upper()]
    if not hasil.empty:
        pola = hasil.iloc[0][kolom_fitur].tolist()
        return [int(x) for x in pola]
    else:
        return None

def pola_ke_huruf(pola_input):
    for index, row in df.iterrows():
        pola_dataset = [int(x) for x in row[kolom_fitur].tolist()]
        if pola_dataset == pola_input:
            return row['Char']
    return None


# ==========================================
# 3. PROGRAM UTAMA (INTERAKTIF)
# ==========================================
def main():
    while True:
        print("\n" + "="*40)
        print("    PROGRAM PENCARIAN DATASET FONT")
        print("="*40)
        print("1. Cari Pola Angka (Input: Huruf)")
        print("2. Cari Huruf (Input: Pola Angka)")
        print("3. Keluar")

        # Variabel input untuk memilih menu
        pilihan = input("Pilih menu (1/2/3): ")

        if pilihan == '1':
            # Variabel input untuk meminta huruf
            input_huruf = input("Masukkan huruf yang ingin dicari (misal: A) : ")
            hasil_pola = huruf_ke_pola(input_huruf)

            if hasil_pola:
                print(f"\n[HASIL] Pola untuk huruf '{input_huruf.upper()}' adalah:")
                print(hasil_pola)
            else:
                print(f"\n[INFO] Huruf '{input_huruf}' tidak ditemukan di dataset.")

        elif pilihan == '2':
            # Variabel input untuk meminta 63 angka
            print("\nMasukkan 63 angka (1 atau -1) pisahkan dengan koma.")
            print("Contoh: 1, -1, 1, 1, -1, ... dst")
            input_pola_str = input("Masukkan pola angka : ")

            try:
                # Mengubah inputan teks (string) menjadi list angka (integer)
                # split(',') memecah teks berdasarkan koma
                input_pola = [int(x.strip()) for x in input_pola_str.split(',')]

                # Cek apakah jumlah angka yang dimasukkan pas 63
                if len(input_pola) != len(kolom_fitur):
                    print(f"\n[ERROR] Jumlah angka yang dimasukkan ada {len(input_pola)}. Harus pas 63 angka!")
                    continue

                hasil_huruf = pola_ke_huruf(input_pola)
                if hasil_huruf:
                    print(f"\n[HASIL] Pola tersebut adalah milik huruf: '{hasil_huruf}'")
                else:
                    print("\n[INFO] Pola angka tidak dikenali di dataset.")

            except ValueError:
                print("\n[ERROR] Input tidak valid! Pastikan hanya memasukkan angka 1 atau -1 yang dipisah koma.")

        elif pilihan == '3':
            print("Keluar dari program. Terima kasih!")
            break

        else:
            print("Pilihan tidak valid, silakan pilih 1, 2, atau 3.")

# Menjalankan program utama
if __name__ == "__main__":
    main()
